  <diagram id="consultar-disponibilidad" name="Consulta de disponibilidad">
    <mxGraphModel page="1" pageWidth="850" pageHeight="550" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gateway" value="API Gateway" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="35" y="135" width="125" height="55" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="Reservas y Agenda" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="205" y="65" width="575" height="335" as="geometry" />
        </mxCell>
        <mxCell id="api" value="API de reservas" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="scope">
