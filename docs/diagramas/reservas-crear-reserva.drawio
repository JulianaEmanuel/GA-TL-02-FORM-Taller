        <mxCell id="note" value="&lt;b&gt;POST /api/reservas/{id}/asistencia&lt;/b&gt;&lt;br&gt;RF-12. Verifica el permiso del encargado y que la reserva esté confirmada.&lt;br&gt;Vincula cada presencia o ausencia con el participante y la reserva." vertex="1" parent="scope" style="text;align=left;spacing=6;html=1;whiteSpace=wrap;"><mxGeometry x="35" y="170" width="720" height="125" as="geometry"/></mxCell>
